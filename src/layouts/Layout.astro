---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import defaultOgImageSrc from '@/assets/images/og-image.png'
import { site } from '@/data/site'
import '@/styles/reset.scss'
import '@/styles/global.scss'

type Props = {
  title?: string
  description?: string
  ogImage?: ImageMetadata
}

const {
  title,
  description = site.description,
  ogImage: ogImageSrc = defaultOgImageSrc,
} = Astro.props

const fullTitle = title ? `${title} | ${site.name}` : site.name
const ogImage = await getImage({ src: ogImageSrc, format: 'jpg', quality: 85 })

const siteUrl = Astro.site ?? Astro.url
const canonicalUrl = new URL(Astro.url.pathname, siteUrl)
const ogImageUrl = new URL(ogImage.src, siteUrl)
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageSrc.width)} />
    <meta property="og:image:height" content={String(ogImageSrc.height)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
  </body>
</html>
